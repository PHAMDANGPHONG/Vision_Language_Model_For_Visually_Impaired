# =========================================================
#  Example environment variables (copy to .env, do not commit .env)
# =========================================================

# Paths to model files (relative to project root or absolute)
VLM_MODEL_PATH=data/models/moondream2-text-model-f16-q4_k_m.gguf
VLM_MMPROJ_PATH=data/models/moondream2-mmproj-f16.gguf
YOLO_MODEL_PATH=data/models/yolov8n.pt
VOSK_MODEL_PATH=data/models/vosk-model-small-vn-0.4
PIPER_VOICE_PATH=data/models/vi_VN-vivos-x_low.onnx
PIPER_VOICE_CONFIG=data/models/vi_VN-vivos-x_low.onnx.json

# Hardware tuning (CPU-only target: 8GB RAM single-channel DDR4-3200)
LLAMA_N_THREADS=6
LLAMA_N_CTX=2048
LLAMA_N_BATCH=256

# Logging
LOG_LEVEL=INFO
LOG_DIR=logs

# Camera
CAMERA_INDEX=0
CAMERA_WIDTH=640
CAMERA_HEIGHT=480
CAMERA_FPS=15
